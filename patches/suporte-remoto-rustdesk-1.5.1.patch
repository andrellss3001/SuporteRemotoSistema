+++ b/flutter/lib/desktop/pages/suporte_remoto_home.dart
@@ -0,0 +1,337 @@
+// Tela inicial simplificada do "Suporte Remoto" (V1, Windows).
+//
+// Modificação do RustDesk (https://github.com/rustdesk/rustdesk), licença AGPL-3.0.
+// Usa somente mecanismos existentes do RustDesk: ID/senha do ServerModel e connect().
+
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_hbb/common.dart';
+import 'package:flutter_hbb/consts.dart';
+import 'package:flutter_hbb/models/platform_model.dart';
+import 'package:flutter_hbb/models/server_model.dart';
+import 'package:provider/provider.dart';
+
+/// Liga a tela simplificada. `false` volta à tela original do RustDesk.
+const bool kSuporteRemoto = true;
+
+/// URL pública do código-fonte modificado (obrigação da AGPL-3.0 ao distribuir).
+/// Altere para o endereço do SEU repositório antes de distribuir.
+const String kSuporteRemotoSourceUrl =
+    'https://github.com/SEU-USUARIO/suporte-remoto';
+
+class SuporteRemotoHome extends StatefulWidget {
+  const SuporteRemotoHome({Key? key}) : super(key: key);
+
+  @override
+  State<SuporteRemotoHome> createState() => _SuporteRemotoHomeState();
+}
+
+class _SuporteRemotoHomeState extends State<SuporteRemotoHome> {
+  final _remoteIdController = TextEditingController();
+  final _remoteIdFocus = FocusNode();
+  Timer? _statusTimer;
+  bool _showPassword = false;
+  int _statusNum = 0;
+  bool _serviceStopped = false;
+  int _activeSessions = 0;
+
+  @override
+  void initState() {
+    super.initState();
+    _statusTimer =
+        periodic_immediate(const Duration(seconds: 1), _updateStatus);
+  }
+
+  @override
+  void dispose() {
+    _statusTimer?.cancel();
+    _remoteIdController.dispose();
+    _remoteIdFocus.dispose();
+    super.dispose();
+  }
+
+  Future<void> _updateStatus() async {
+    try {
+      final status = jsonDecode(await bind.mainGetConnectStatus())
+          as Map<String, dynamic>;
+      final stopped = await mainGetBoolOption(kOptionStopService);
+      final statusNum = status['status_num'] as int? ?? 0;
+      final sessions = status['video_conn_count'] as int? ?? 0;
+      if (!mounted) return;
+      if (statusNum != _statusNum ||
+          stopped != _serviceStopped ||
+          sessions != _activeSessions) {
+        setState(() {
+          _statusNum = statusNum;
+          _serviceStopped = stopped;
+          _activeSessions = sessions;
+        });
+      }
+    } catch (e) {
+      debugPrint('SuporteRemoto: falha ao ler status: $e');
+    }
+  }
+
+  String _cleanId(String text) => text.replaceAll(RegExp(r'\s'), '');
+
+  void _connect({bool isFileTransfer = false}) {
+    final id = _cleanId(_remoteIdController.text);
+    if (id.isEmpty) {
+      showToast('Digite o ID do computador remoto.');
+      _remoteIdFocus.requestFocus();
+      return;
+    }
+    connect(context, id, isFileTransfer: isFileTransfer);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    return Container(
+      color: theme.scaffoldBackgroundColor,
+      padding: const EdgeInsets.fromLTRB(24, 16, 24, 12),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          _buildHeader(theme),
+          if (_activeSessions > 0) _buildActiveSessionBanner(),
+          const SizedBox(height: 16),
+          Expanded(
+            child: SingleChildScrollView(
+              child: Row(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Expanded(child: _buildMyComputerCard(theme)),
+                  const SizedBox(width: 16),
+                  Expanded(child: _buildAccessClientCard(theme)),
+                ],
+              ),
+            ),
+          ),
+          _buildFooter(theme),
+        ],
+      ),
+    );
+  }
+
+  Widget _buildHeader(ThemeData theme) {
+    return Row(
+      children: [
+        const Icon(Icons.support_agent, size: 32, color: MyTheme.accent),
+        const SizedBox(width: 10),
+        Text(
+          'SUPORTE REMOTO SISTEMA',
+          style: theme.textTheme.titleLarge?.copyWith(
+              fontWeight: FontWeight.bold, letterSpacing: 1.5),
+        ),
+      ],
+    );
+  }
+
+  Widget _buildActiveSessionBanner() {
+    return Container(
+      margin: const EdgeInsets.only(top: 12),
+      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
+      decoration: BoxDecoration(
+        color: const Color(0xFFB71C1C),
+        borderRadius: BorderRadius.circular(8),
+      ),
+      child: const Row(
+        children: [
+          Icon(Icons.screen_share, color: Colors.white),
+          SizedBox(width: 10),
+          Expanded(
+            child: Text(
+              'ATENDIMENTO REMOTO EM ANDAMENTO — um técnico está conectado a '
+              'este computador. Use a janela de controle para desconectar.',
+              style: TextStyle(color: Colors.white, fontWeight: FontWeight.w600),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _card(ThemeData theme, String title, List<Widget> children) {
+    return Container(
+      padding: const EdgeInsets.all(18),
+      decoration: BoxDecoration(
+        color: theme.colorScheme.background,
+        borderRadius: BorderRadius.circular(10),
+        border: Border.all(color: theme.dividerColor),
+      ),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          Text(title,
+              style: theme.textTheme.titleMedium?.copyWith(
+                  fontWeight: FontWeight.bold,
+                  color: MyTheme.accent,
+                  letterSpacing: 1.2)),
+          const SizedBox(height: 14),
+          ...children,
+        ],
+      ),
+    );
+  }
+
+  Widget _label(ThemeData theme, String text) => Text(
+        text,
+        style: TextStyle(
+            fontSize: 13,
+            color: theme.textTheme.titleLarge?.color?.withOpacity(0.6)),
+      );
+
+  Widget _buildMyComputerCard(ThemeData theme) {
+    return ChangeNotifierProvider.value(
+      value: gFFI.serverModel,
+      child: Consumer<ServerModel>(
+        builder: (context, model, child) {
+          final id = model.serverId.text;
+          final password = model.serverPasswd.text;
+          return _card(theme, 'MEU COMPUTADOR', [
+            _label(theme, 'Meu ID:'),
+            SelectableText(id,
+                style: const TextStyle(
+                    fontSize: 26, fontWeight: FontWeight.w600)),
+            const SizedBox(height: 10),
+            _label(theme, 'Senha temporária:'),
+            Row(
+              children: [
+                Expanded(
+                  child: SelectableText(
+                    _showPassword ? password : '********',
+                    style: const TextStyle(
+                        fontSize: 22, fontWeight: FontWeight.w600),
+                  ),
+                ),
+                IconButton(
+                  tooltip: 'Gerar nova senha',
+                  icon: const Icon(Icons.refresh),
+                  onPressed: () => bind.mainUpdateTemporaryPassword(),
+                ),
+              ],
+            ),
+            const SizedBox(height: 10),
+            Wrap(
+              spacing: 8,
+              runSpacing: 8,
+              children: [
+                OutlinedButton.icon(
+                  icon: const Icon(Icons.copy, size: 18),
+                  label: const Text('Copiar ID'),
+                  onPressed: () {
+                    Clipboard.setData(ClipboardData(text: _cleanId(id)));
+                    showToast('ID copiado');
+                  },
+                ),
+                OutlinedButton.icon(
+                  icon: Icon(
+                      _showPassword ? Icons.visibility_off : Icons.visibility,
+                      size: 18),
+                  label: Text(
+                      _showPassword ? 'Ocultar senha' : 'Mostrar senha'),
+                  onPressed: () =>
+                      setState(() => _showPassword = !_showPassword),
+                ),
+              ],
+            ),
+            const SizedBox(height: 16),
+            _buildStatus(),
+          ]);
+        },
+      ),
+    );
+  }
+
+  Widget _buildStatus() {
+    final String text;
+    final Color color;
+    if (_serviceStopped) {
+      text = 'Serviço parado.';
+      color = kColorWarn;
+    } else if (_statusNum == 1) {
+      text = 'Pronto para receber suporte.';
+      color = const Color.fromARGB(255, 50, 190, 166);
+    } else if (_statusNum == 0) {
+      text = 'Conectando ao servidor...';
+      color = kColorWarn;
+    } else {
+      text = 'Sem conexão com o servidor. Verifique a internet.';
+      color = const Color.fromARGB(255, 224, 79, 95);
+    }
+    return Row(
+      children: [
+        Container(
+          width: 10,
+          height: 10,
+          decoration: BoxDecoration(color: color, shape: BoxShape.circle),
+        ),
+        const SizedBox(width: 8),
+        Expanded(child: Text('Status: $text')),
+      ],
+    );
+  }
+
+  Widget _buildAccessClientCard(ThemeData theme) {
+    return _card(theme, 'ACESSAR CLIENTE', [
+      _label(theme, 'ID do computador remoto:'),
+      const SizedBox(height: 6),
+      TextField(
+        controller: _remoteIdController,
+        focusNode: _remoteIdFocus,
+        style: const TextStyle(fontSize: 20),
+        inputFormatters: [
+          FilteringTextInputFormatter.allow(RegExp(r'[0-9A-Za-z\s\-_@.:]')),
+        ],
+        decoration: const InputDecoration(
+          hintText: '123 456 789',
+          border: OutlineInputBorder(),
+          contentPadding: EdgeInsets.symmetric(horizontal: 12, vertical: 12),
+        ),
+        onSubmitted: (_) => _connect(),
+      ),
+      const SizedBox(height: 14),
+      SizedBox(
+        width: double.infinity,
+        height: 42,
+        child: ElevatedButton.icon(
+          icon: const Icon(Icons.desktop_windows),
+          label: const Text('Conectar', style: TextStyle(fontSize: 16)),
+          onPressed: () => _connect(),
+        ),
+      ),
+      const SizedBox(height: 8),
+      SizedBox(
+        width: double.infinity,
+        height: 38,
+        child: OutlinedButton.icon(
+          icon: const Icon(Icons.folder_copy_outlined),
+          label: const Text('Transferir arquivos'),
+          onPressed: () => _connect(isFileTransfer: true),
+        ),
+      ),
+      const SizedBox(height: 12),
+      _label(theme,
+          'Você vai digitar a senha temporária informada pelo cliente; '
+          'em seguida, ele precisa clicar em "Aceitar" no computador dele.'),
+    ]);
+  }
+
+  Widget _buildFooter(ThemeData theme) {
+    return Padding(
+      padding: const EdgeInsets.only(top: 8),
+      child: Text(
+        'Baseado no RustDesk (AGPL-3.0). Código-fonte: $kSuporteRemotoSourceUrl',
+        textAlign: TextAlign.center,
+        style: TextStyle(
+            fontSize: 11,
+            color: theme.textTheme.titleLarge?.color?.withOpacity(0.45)),
+      ),
+    );
+  }
+}
