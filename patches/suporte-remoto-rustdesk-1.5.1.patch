diff --git a/src/suporte_remoto.rs b/src/suporte_remoto.rs
new file mode 100644
index 0000000..f0fa313
--- /dev/null
+++ b/src/suporte_remoto.rs
@@ -0,0 +1,94 @@
+//! Personalização "Suporte Remoto" (V1, Windows x64) aplicada sobre o RustDesk.
+//!
+//! Este arquivo é uma modificação do RustDesk (https://github.com/rustdesk/rustdesk),
+//! distribuída sob a licença AGPL-3.0. Toda a personalização em tempo de execução fica
+//! concentrada aqui, para que a atualização para novas versões do RustDesk exija apenas
+//! reaplicar os poucos ganchos (hooks) que chamam este módulo.
+
+use base::config::keys;
+use hbb_common::config;
+
+/// Nome interno do aplicativo. O RustDesk aceita apenas letras, números e hífen
+/// (veja `src/lang.rs`), por isso não há espaço. Ele define a pasta de configuração
+/// (`%APPDATA%\SuporteRemotoSistema`), o título da janela e substitui "RustDesk" nos textos.
+pub const APP_NAME: &str = "SuporteRemotoSistema";
+
+// Servidor próprio (hbbs/hbbr), definido em tempo de compilação pelas variáveis de
+// ambiente abaixo. Se ficarem vazias, são usados os servidores públicos do RustDesk.
+const SERVER: Option<&str> = option_env!("SUPORTE_REMOTO_SERVER");
+const RELAY: Option<&str> = option_env!("SUPORTE_REMOTO_RELAY");
+const KEY: Option<&str> = option_env!("SUPORTE_REMOTO_KEY");
+
+/// Aplica nome, idioma, tema e restrições. Chamado no início de `load_custom_client()`,
+/// que é executado por todos os processos (interface, servidor e gerenciador de conexão).
+pub fn apply() {
+    *config::APP_NAME.write().unwrap() = APP_NAME.to_owned();
+
+    {
+        // Opções "rígidas": sem instalação (somente portátil), sem tela de
+        // configurações, sem catálogo de endereços e sem contas de usuário.
+        let mut hard = config::HARD_SETTINGS.write().unwrap();
+        for k in [
+            "disable-installation",
+            "disable-settings",
+            "disable-ab",
+            "disable-account",
+        ] {
+            hard.insert(k.to_owned(), "Y".to_owned());
+        }
+    }
+
+    {
+        let mut builtin = config::BUILTIN_SETTINGS.write().unwrap();
+        builtin.insert(keys::OPTION_HIDE_HELP_CARDS.to_owned(), "Y".to_owned());
+    }
+
+    {
+        let mut local = config::OVERWRITE_LOCAL_SETTINGS.write().unwrap();
+        local.insert(keys::OPTION_THEME.to_owned(), "dark".to_owned());
+        local.insert(keys::OPTION_LANGUAGE.to_owned(), "pt-br".to_owned());
+    }
+
+    let mut settings = config::OVERWRITE_SETTINGS.write().unwrap();
+    // Somente senha temporária (nunca senha permanente / acesso não assistido).
+    settings.insert(
+        keys::OPTION_VERIFICATION_METHOD.to_owned(),
+        "use-temporary-password".to_owned(),
+    );
+    // Vazio = modo "senha e clique". Nunca "password", que ocultaria a janela do
+    // gerenciador de conexão (o indicador de atendimento e o botão Desconectar).
+    settings.insert(keys::OPTION_APPROVE_MODE.to_owned(), "".to_owned());
+    // Recursos fora do escopo da V1.
+    settings.insert(keys::OPTION_ENABLE_TUNNEL.to_owned(), "N".to_owned());
+    settings.insert(keys::OPTION_ENABLE_TERMINAL.to_owned(), "N".to_owned());
+    settings.insert(
+        keys::OPTION_ALLOW_REMOTE_CONFIG_MODIFICATION.to_owned(),
+        "N".to_owned(),
+    );
+
+    if let Some(server) = non_empty(SERVER) {
+        settings.insert(
+            keys::OPTION_CUSTOM_RENDEZVOUS_SERVER.to_owned(),
+            server.to_owned(),
+        );
+        // Sem relay explícito, o hbbs informa o relay configurado nele (-r).
+        if let Some(relay) = non_empty(RELAY) {
+            settings.insert(keys::OPTION_RELAY_SERVER.to_owned(), relay.to_owned());
+        }
+        if let Some(key) = non_empty(KEY) {
+            settings.insert("key".to_owned(), key.to_owned());
+        }
+    }
+}
+
+/// Exige que o técnico informe a senha temporária correta E que o cliente clique em
+/// "Aceitar". O RustDesk original aceita senha OU clique.
+#[inline]
+pub fn require_click_after_password() -> bool {
+    true
+}
+
+fn non_empty(v: Option<&'static str>) -> Option<&'static str> {
+    v.map(str::trim).filter(|s| !s.is_empty())
+}
+
